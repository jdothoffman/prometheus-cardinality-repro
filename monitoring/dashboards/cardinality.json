    {
      "type": "timeseries",
      "title": "Node memory used / capacity (by node)",
      "description": "k3d fakes /proc/meminfo, so this uses cAdvisor working set vs node capacity. agentpool-0 = Alloy's dedicated pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
