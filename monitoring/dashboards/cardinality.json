{
  "uid": "cardinality-repro",
  "title": "Cardinality Repro",
  "tags": [
    "cardinality",
    "repro"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Pipeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**transactions-api** (4 replicas \u00d7 50 simulated pods, OTel SDK in-memory, OTLP push every 10s) \u2192 **Alloy** (agent node pool, batch \u2192 remote_write) \u2192 **Prometheus** (1Gi limit).  Gaps in panels = Prometheus is down. k6 latency is remote-written straight to Prometheus, bypassing Alloy."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "response_time label",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "green"
                },
                "1": {
                  "text": "ON (bug)",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(transactions_cardinality_unbounded{job=\"transactions-api\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 2
    },
