        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, container, reason) (kube_pod_container_status_last_terminated_reason{container=~\"prometheus|alloy|app\"}) == 1",
          "legendFormat": "{{namespace}}/{{container}} {{reason}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, container) (kube_pod_container_status_restarts_total{container=~\"prometheus|alloy|app\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "last OOM/term",
              "Value #B": "restarts"
            }
          }
        }
      ],
      "id": 12
    },
